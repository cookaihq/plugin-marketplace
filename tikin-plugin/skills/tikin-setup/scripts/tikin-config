#!/usr/bin/env python3
# --- runtime bootstrap (ADR 0007) -------------------------------------------
# Runs before anything else so the process always ends up on this skill's own
# pinned interpreter, no matter how the caller launched the script. Python 3.9
# compatible syntax only: the system interpreter may execute this part.
import os
import shlex
import subprocess
import sys

REEXEC_ENV = "TIKIN_SETUP_BOOTSTRAP_REEXEC"

# scripts/tikin-config -> skills/tikin-setup/
SKILL_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
# A relative UV_PROJECT_ENVIRONMENT resolves against the project root, the way uv
# resolves it. An absolute value is returned unchanged by os.path.join.
VENV_DIR = os.path.join(SKILL_DIR, os.environ.get("UV_PROJECT_ENVIRONMENT") or ".venv")
VENV_PY = os.path.join(VENV_DIR, "bin", "python")


def _bootstrap_fail(message):
    sys.stderr.write(message + "\n")
    raise SystemExit(1)


def _bootstrap_manual_hint():
    return "rm -rf %s && uv sync --no-dev --project %s" % (
        shlex.quote(VENV_DIR),
        shlex.quote(SKILL_DIR),
    )


def _bootstrap_venv_is_valid():
    # bin/python alone is not enough: an interrupted sync, a same-named directory
    # or a stale symlink all leave an interpreter behind without a real venv.
    return os.path.exists(VENV_PY) and os.path.exists(
        os.path.join(VENV_DIR, "pyvenv.cfg")
    )


_BOOTSTRAP_TARGET = os.path.realpath(VENV_DIR)

if os.path.realpath(sys.prefix) == _BOOTSTRAP_TARGET:
    if os.environ.get(REEXEC_ENV) == _BOOTSTRAP_TARGET:
        os.environ.pop(REEXEC_ENV, None)
else:
    if os.environ.get(REEXEC_ENV) == _BOOTSTRAP_TARGET:
        _bootstrap_fail(
            "tikin-setup runtime is broken: restarted into %s but the interpreter is "
            "still outside that venv.\nRebuild it manually: %s"
            % (VENV_DIR, _bootstrap_manual_hint())
        )
    if not _bootstrap_venv_is_valid():
        try:
            _probe = subprocess.run(
                ["uv", "--version"],
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=30,
            )
        except (OSError, subprocess.SubprocessError):
            _bootstrap_fail(
                "uv is not installed. Run: curl -LsSf https://astral.sh/uv/install.sh | sh"
            )
        _parts = _probe.stdout.decode("utf-8", "replace").split()  # "uv 0.8.11 (...)"
        _found = _parts[1] if len(_parts) > 1 else "0"
        try:
            _numeric = tuple(int(x) for x in (_found.split(".") + ["0", "0"])[:2])
        except ValueError:
            _numeric = (0, 0)  # uv error output is "error: ...", not a version
        if _numeric < (0, 8):
            _bootstrap_fail(
                "uv is too old (need >= 0.8, found %s). Run: uv self update" % _found
            )
        sys.stderr.write(
            "[bootstrap] runtime missing, rebuilding %s from uv.lock ...\n" % VENV_DIR
        )
        try:
            _sync = subprocess.run(
                # --no-dev: the runtime only ever needs the shipping deps; dev
                # extras must not be pulled onto a user machine at first run.
                ["uv", "sync", "--no-dev", "--project", SKILL_DIR],
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=600,  # every network call needs a budget (ADR 0006)
            )
        except subprocess.TimeoutExpired:
            _bootstrap_fail(
                "uv sync did not finish within 600s, the network is likely down. "
                "Run manually: " + _bootstrap_manual_hint()
            )
        if _sync.returncode != 0 or not _bootstrap_venv_is_valid():
            _bootstrap_fail(
                "uv sync failed, the runtime could not be rebuilt (run manually: %s):\n%s"
                % (
                    _bootstrap_manual_hint(),
                    _sync.stdout.decode("utf-8", "replace"),
                )
            )
    os.environ[REEXEC_ENV] = _BOOTSTRAP_TARGET
    os.execv(VENV_PY, [VENV_PY] + sys.argv)
# --- end runtime bootstrap ---------------------------------------------------

import argparse
import getpass
import json
from pathlib import Path
import re
import tempfile
import time
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen


DEFAULT_SETTINGS = {"routing": {"default": "auto", "platforms": {}}}
# Transient-failure policy (ADR 0006 / the Reliability section of tikin-rest-api):
# 3 attempts in total, waiting 1s then 2s. 429 with Retry-After wins over the backoff.
VALIDATE_MAX_ATTEMPTS = 3
VALIDATE_BACKOFF_SECONDS = (1.0, 2.0)
VALIDATE_RETRY_AFTER_CAP_SECONDS = 60.0
ENV_ASSIGNMENT = re.compile(r"^(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$")
MODES = ("auto", "confirm")
PLATFORMS = (
    "douyin",
    "instagram",
    "threads",
    "tiktok",
    "twitter",
    "xiaohongshu",
    "youtube",
)


def config_dir():
    root = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
    return root / "tikin"


def restrict_permissions(path=None, fd=None):
    if fd is not None:
        fchmod = getattr(os, "fchmod", None)
        if fchmod is not None:
            fchmod(fd, 0o600)
    if path is not None:
        try:
            os.chmod(path, 0o600)
        except NotImplementedError:
            if os.name != "nt":
                raise


def atomic_write(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary_name = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        restrict_permissions(fd=fd)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(content)
        os.replace(temporary_name, path)
        restrict_permissions(path=path)
    except BaseException:
        try:
            os.unlink(temporary_name)
        except FileNotFoundError:
            pass
        raise


def initialize():
    directory = config_dir()
    directory.mkdir(parents=True, exist_ok=True)
    legacy_env_path = directory / "env"
    env_path = directory / ".env"
    settings_path = directory / "settings.json"
    for path in (legacy_env_path, env_path, settings_path):
        if path.is_symlink():
            raise SystemExit(f"refusing symbolic link at {path}")
    if not env_path.exists() and legacy_env_path.is_file():
        os.replace(legacy_env_path, env_path)
    if legacy_env_path.is_file():
        restrict_permissions(path=legacy_env_path)
    if env_path.is_file():
        restrict_permissions(path=env_path)

    if not settings_path.exists():
        atomic_write(settings_path, json.dumps(DEFAULT_SETTINGS, indent=2) + "\n")
    elif settings_path.is_file():
        restrict_permissions(path=settings_path)


def parse_env_file(path):
    values = {}
    if not path.is_file():
        return values
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        match = ENV_ASSIGNMENT.match(raw_line.strip())
        if not match:
            continue
        key, raw_value = match.groups()
        try:
            parsed = shlex.split(raw_value, posix=True)
        except ValueError:
            continue
        values[key] = parsed[0] if len(parsed) == 1 else raw_value
    return values


def read_settings():
    path = config_dir() / "settings.json"
    if not path.is_file():
        return DEFAULT_SETTINGS
    settings = json.loads(path.read_text(encoding="utf-8"))
    routing = settings.get("routing")
    if not isinstance(routing, dict) or routing.get("default") not in MODES:
        raise SystemExit("settings.json has an invalid routing.default")
    platforms = routing.get("platforms")
    if not isinstance(platforms, dict):
        raise SystemExit("settings.json has an invalid routing.platforms")
    for platform, mode in platforms.items():
        if platform not in PLATFORMS or mode not in MODES:
            raise SystemExit("settings.json has an invalid platform routing override")
    return settings


def set_key():
    if sys.stdin.isatty():
        secret = getpass.getpass("TIKIN_API_KEY: ")
    else:
        secret = sys.stdin.read().rstrip("\r\n")
    if not secret or "\n" in secret or "\r" in secret or "\0" in secret:
        raise SystemExit("refusing an empty or multi-line API key")

    path = config_dir() / ".env"
    lines = path.read_text(encoding="utf-8").splitlines() if path.is_file() else []
    replacement = f"TIKIN_API_KEY={shlex.quote(secret)}"
    updated = []
    replaced = False
    for line in lines:
        match = ENV_ASSIGNMENT.match(line.strip())
        if match and match.group(1) == "TIKIN_API_KEY":
            if not replaced:
                updated.append(replacement)
                replaced = True
            continue
        updated.append(line)
    if not replaced:
        updated.append(replacement)
    atomic_write(path, "\n".join(updated) + "\n")


def status():
    file_values = parse_env_file(config_dir() / ".env")
    settings = read_settings()
    if os.environ.get("TIKIN_API_KEY"):
        key_source = "environment"
    elif file_values.get("TIKIN_API_KEY"):
        key_source = "file"
    else:
        key_source = "missing"
    print(
        json.dumps(
            {
                "key_configured": key_source != "missing",
                "key_source": key_source,
                "settings": {"routing": settings["routing"]},
            },
            sort_keys=True,
        )
    )


def set_routing(default_mode, platform_values, clear_platforms):
    settings = read_settings()
    routing = settings["routing"]
    if default_mode:
        routing["default"] = default_mode
    if clear_platforms:
        routing["platforms"] = {}
    for value in platform_values:
        if "=" not in value:
            raise SystemExit("platform overrides must use PLATFORM=MODE")
        platform, mode = value.split("=", 1)
        if platform not in PLATFORMS:
            raise SystemExit(f"unsupported platform: {platform}")
        if mode not in MODES:
            raise SystemExit(f"unsupported routing mode: {mode}")
        routing["platforms"][platform] = mode
    routing["platforms"] = dict(sorted(routing["platforms"].items()))
    atomic_write(
        config_dir() / "settings.json",
        json.dumps(settings, indent=2, sort_keys=True) + "\n",
    )


def get_policy(platform):
    if platform not in PLATFORMS:
        raise SystemExit(f"unsupported platform: {platform}")
    routing = read_settings()["routing"]
    print(routing["platforms"].get(platform, routing["default"]))


def retry_after_seconds(error):
    """Seconds requested by a 429's Retry-After header, or None to use the backoff."""
    headers = getattr(error, "headers", None)
    raw = headers.get("Retry-After") if headers else None
    if not raw:
        return None
    try:
        seconds = float(str(raw).strip())
    except (TypeError, ValueError):
        return None  # HTTP-date form: fall back to the fixed backoff schedule
    if seconds < 0:
        return None
    return min(seconds, VALIDATE_RETRY_AFTER_CAP_SECONDS)


def log_validation_retry(attempt, reason, delay):
    # Only the failure class is logged. The key is never part of this message.
    sys.stderr.write(
        "key validation attempt %d/%d failed (%s); retrying in %.0fs\n"
        % (attempt, VALIDATE_MAX_ATTEMPTS, reason, delay)
    )


def validate_once(request, timeout):
    """Run one validation call.

    Returns (outcome, detail, retry_after) where outcome is "ok", "fatal" (a
    deterministic failure that must not be retried) or "transient".
    """
    try:
        with urlopen(request, timeout=timeout) as response:
            if 200 <= response.status < 300:
                return ("ok", None, None)
        return ("fatal", "key validation returned an unexpected response", None)
    except HTTPError as error:
        if error.code in (401, 403):
            return ("fatal", "invalid TIKIN_API_KEY", None)
        if error.code == 429 or error.code >= 500:
            return ("transient", f"HTTP {error.code}", retry_after_seconds(error))
        return ("fatal", f"key validation failed with HTTP {error.code}", None)
    except URLError as error:
        return ("transient", f"connection failed: {error.reason}", None)
    except (TimeoutError, OSError) as error:
        # socket.timeout, connection resets and other transport-level faults.
        return ("transient", f"connection failed: {error}", None)


def validate_key(timeout):
    file_values = parse_env_file(config_dir() / ".env")
    key = os.environ.get("TIKIN_API_KEY") or file_values.get("TIKIN_API_KEY")
    if not key:
        raise SystemExit("missing TIKIN_API_KEY")
    base_url = (
        os.environ.get("TIKIN_BASE_URL")
        or file_values.get("TIKIN_BASE_URL")
        or "https://console.tikin.net"
    )
    request = Request(
        f"{base_url.rstrip('/')}/api/usage/token/",
        headers={"Authorization": f"Bearer {key}", "Accept": "application/json"},
    )
    reason = "unknown error"
    for attempt in range(1, VALIDATE_MAX_ATTEMPTS + 1):
        outcome, detail, retry_after = validate_once(request, timeout)
        if outcome == "ok":
            print("valid")
            return
        if outcome == "fatal":
            raise SystemExit(detail) from None
        reason = detail
        if attempt == VALIDATE_MAX_ATTEMPTS:
            break
        delay = (
            retry_after
            if retry_after is not None
            else VALIDATE_BACKOFF_SECONDS[attempt - 1]
        )
        log_validation_retry(attempt, reason, delay)
        time.sleep(delay)
    raise SystemExit(
        f"key validation could not reach tikin after {VALIDATE_MAX_ATTEMPTS} attempts ({reason})"
    ) from None


def main():
    parser = argparse.ArgumentParser(description="Manage local tikin configuration safely.")
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("init")
    subparsers.add_parser("set-key")
    subparsers.add_parser("status")
    set_routing_parser = subparsers.add_parser("set-routing")
    set_routing_parser.add_argument("--default", choices=MODES)
    set_routing_parser.add_argument("--platform", action="append", default=[])
    set_routing_parser.add_argument("--clear-platforms", action="store_true")
    get_policy_parser = subparsers.add_parser("get-policy")
    get_policy_parser.add_argument("platform", choices=PLATFORMS)
    validate_parser = subparsers.add_parser("validate")
    # 30s matches the `--max-time 30` that the Reliability section of
    # tikin-rest-api mandates for every JSON call against $BASE. Validation is
    # exactly such a call, so it must not time out earlier than the documented
    # budget — a 10s cap turned slow-but-healthy responses into "transient
    # failure" retries.
    validate_parser.add_argument("--timeout", type=float, default=30.0)
    args = parser.parse_args()

    if args.command == "init":
        initialize()
    elif args.command == "set-key":
        initialize()
        set_key()
    elif args.command == "status":
        initialize()
        status()
    elif args.command == "set-routing":
        initialize()
        set_routing(args.default, args.platform, args.clear_platforms)
    elif args.command == "get-policy":
        initialize()
        get_policy(args.platform)
    elif args.command == "validate":
        initialize()
        validate_key(args.timeout)


if __name__ == "__main__":
    main()
