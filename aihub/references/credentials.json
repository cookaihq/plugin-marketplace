{
  "schema_version": 1,
  "consumer": {
    "kind": "plugin",
    "name": "aihub",
    "skills": ["aihub-image", "aihub-video", "aihub-audio", "aihub-music", "aihub-understanding", "aihub-document"]
  },
  "keys": {
    "AIHUB_API_KEY": {"required": true, "sensitive": true, "description": "AIhub 调用密钥，必须属于最终使用的服务与账号"},
